{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DmV554/alma-gantt/schema/ops-0.json",
  "title": "alma batch operations, schema version 0",
  "description": "Input of `alma apply`: a JSON array of operations, or one operation per line. The batch applies all or nothing.",
  "type": "array",
  "items": { "$ref": "#/$defs/op" },
  "$defs": {
    "fields": {
      "description": "Keys of the target table (`alma keys task`); values are strings (dates as YYYY-MM-DD) or arrays of strings. `constraint` is TYPE or TYPE:DATE; `estimate` is O/M/P (e.g. 25d/30d/40d); `spans` is FROM..TO; sub-keys use a dot: `estimate.basis`, `fixed_cost.accrue`, `custom.zone`.",
      "type": "object",
      "additionalProperties": { "oneOf": [ { "type": "string" }, { "type": "array", "items": { "type": "string" } } ] }
    },
    "op": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["op", "id", "name"],
          "properties": { "op": { "const": "task.add" }, "id": { "type": "string" }, "name": { "type": "string" },
            "parent": { "type": "string" }, "after": { "type": "string" }, "fields": { "$ref": "#/$defs/fields" },
            "upsert": { "type": "boolean" } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "id"],
          "properties": { "op": { "const": "task.set" }, "id": { "type": "string" }, "fields": { "$ref": "#/$defs/fields" },
            "unset": { "type": "array", "items": { "type": "string" } } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "id"],
          "properties": { "op": { "const": "task.rm" }, "id": { "type": "string" }, "cascade": { "type": "boolean" } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "id"],
          "properties": { "op": { "const": "task.move" }, "id": { "type": "string" }, "parent": { "type": "string" },
            "after": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "pred", "succ"],
          "properties": { "op": { "const": "dep.add" }, "pred": { "type": "string" }, "succ": { "type": "string" },
            "type": { "enum": ["FS", "SS", "FF", "SF"] }, "lag": { "type": "string" },
            "nature": { "enum": ["mandatory", "discretionary"] }, "scope": { "enum": ["internal", "external"] },
            "rationale": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "pred", "succ"],
          "properties": { "op": { "const": "dep.rm" }, "pred": { "type": "string" }, "succ": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "id"],
          "properties": { "op": { "const": "res.add" }, "id": { "type": "string" }, "name": { "type": "string" },
            "kind": { "enum": ["work", "equipment", "material", "cost"] }, "rate": { "type": "string", "description": "AMOUNT/PER, e.g. 4.2/day" },
            "max_units": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "task", "resource"],
          "properties": { "op": { "const": "assign" }, "task": { "type": "string" }, "resource": { "type": "string" },
            "units": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "task", "resource"],
          "properties": { "op": { "const": "unassign" }, "task": { "type": "string" }, "resource": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "id", "start", "length", "count"],
          "properties": { "op": { "const": "cadence.add" }, "id": { "type": "string" }, "start": { "type": "string", "format": "date" },
            "length": { "type": "string" }, "count": { "type": "integer", "minimum": 1, "maximum": 999 },
            "name": { "type": "string" }, "prefix": { "type": "string" }, "calendar": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "id"],
          "properties": { "op": { "const": "cadence.rm" }, "id": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "fields"],
          "properties": { "op": { "const": "project.set" }, "fields": { "$ref": "#/$defs/fields" } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "id"],
          "properties": { "op": { "const": "cal.add" }, "id": { "type": "string" }, "name": { "type": "string" },
            "workdays": { "type": "array", "items": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] } },
            "hours": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}-[0-9]{2}:[0-9]{2}$" } } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "calendar", "name", "from", "to"],
          "properties": { "op": { "const": "cal.except" }, "calendar": { "type": "string" }, "name": { "type": "string" },
            "from": { "type": "string", "format": "date" }, "to": { "type": "string", "format": "date" },
            "working": { "type": "boolean" } } },
        { "type": "object", "additionalProperties": false, "required": ["op", "code", "severity"],
          "properties": { "op": { "const": "rule.set" }, "code": { "type": "string", "pattern": "^L-[A-Z]+-[0-9]{2}$" },
            "severity": { "enum": ["off", "info", "warn", "error"] } } }
      ]
    }
  }
}
